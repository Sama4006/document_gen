# ---- OpenAI (required) ----
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Chat model. Any chat-completions model your key can use.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: another OpenAI-compatible endpoint (Azure, a local server, ...)
# OPENAI_BASE_URL=
# Optional: leave unset to use the model's default temperature
# OPENAI_TEMPERATURE=0.7
# MAX_OUTPUT_TOKENS=2000

# ---- Server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Comma-separated origins allowed to call the API, or *
CORS_ORIGINS=*
# Optional shared secret. If set, clients must send it as the X-API-Key header.
# API_KEY=
# MAX_UPLOAD_MB=20

# ---- Knowledge base (ChromaDB) ----
CHROMA_DB_PATH=./chroma_data
COLLECTION_NAME=documents
# Characters per passage and overlap between passages
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# ---- Files ----
TEMPLATES_DIR=./templates
OUTPUT_DIR=./output
